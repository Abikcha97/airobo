APP_ENV=production
APP_KEY=base64:your_app_key_here
APP_DEBUG=false
APP_URL=https://api.cashwithdrawal.uz

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres-primary
DB_PORT=5432
DB_DATABASE=cashwithdrawal
DB_USERNAME=cwuser
DB_PASSWORD=strong_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_PRIVATE_KEY_PATH=/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt_public.pem
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Payment Provider
PAYMENT_PROVIDER=oson
PAYMENT_SANDBOX_MODE=false
COMMISSION_RATE=3.0

# OSON
OSON_BASE_URL=https://api.oson.uz/v2
OSON_API_KEY=
OSON_SERVICE_ID=8947
OSON_TIMEOUT=30

# PAYNET
PAYNET_BASE_URL=https://api.paynet.uz/v1
PAYNET_MERCHANT_ID=
PAYNET_SECRET_KEY=
PAYNET_TIMEOUT=30

# SMS Gateway
SMS_GATEWAY_URL=https://notify.eskiz.uz/api
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_EMAIL=

# Dispenser
DISPENSER_TCP_HOST=127.0.0.1
DISPENSER_TCP_PORT=9000
DISPENSER_TIMEOUT=60
